{
  "name": "carboniq-fintech",
  "version": "0.1.0",
  "description": "CarbonIQ FinTech — Bank-facing API layer for construction carbon intelligence",
  "license": "Apache-2.0",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node scripts/jest.js",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "setup:env": "node scripts/generate-env.js",
    "setup:verify": "node scripts/verify-setup.js",
    "setup:seed": "node scripts/seed-demo-data.js",
    "setup:seed-clear": "node scripts/seed-demo-data.js --clear",
    "key:create": "node scripts/create-api-key.js create",
    "key:list": "node scripts/create-api-key.js list",
    "key:revoke": "node scripts/create-api-key.js revoke",
    "key:register-ui": "node scripts/register-ui-key.js",
    "docs:conformance": "node scripts/generate-conformance-doc.js",
    "docs:gcf-conformance": "node scripts/generate-gcf-conformance-doc.js",
    "docs:parta-conformance": "node scripts/generate-parta-conformance-doc.js",
    "setup:seed-partc": "node scripts/seed-partc-demo.js",
    "build:info": "node scripts/build-info.js",
    "db:migrate": "node scripts/db-migrate.js up",
    "db:status": "node scripts/db-migrate.js status",
    "db:rollback": "node scripts/db-migrate.js down",
    "db:backfill": "node scripts/migrate-to-postgres.js",
    "db:backup": "node scripts/db-backup.js",
    "db:verify-audit": "node scripts/db-verify-audit.js",
    "test:postgres": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://carboniq@127.0.0.1:54329/carboniq_test} node scripts/jest.js",
    "test:scale": "SCALE_STRICT=1 TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://carboniq@127.0.0.1:54329/carboniq_test} jest --runInBand tests/pg-scale.test.js",
    "key:scope": "node scripts/create-api-key.js scope",
    "key:rotate": "node scripts/create-api-key.js rotate",
    "key:expire": "node scripts/create-api-key.js expire",
    "docs:scopes": "node scripts/generate-scopes-doc.js",
    "docs:openapi": "node scripts/generate-openapi.js",
    "worker": "node scripts/worker.js",
    "typecheck": "tsc -p jsconfig.json && tsc -p ui/jsconfig.json && tsc -p tests/jsconfig.json",
    "build:ui": "node scripts/build-ui.js",
    "test:e2e": "npm run build:ui && playwright test",
    "pretypecheck": "node scripts/build-info.js",
    "user:create": "node scripts/manage-users.js create",
    "user:list": "node scripts/manage-users.js list",
    "user:role": "node scripts/manage-users.js role",
    "user:passwd": "node scripts/manage-users.js passwd",
    "user:trial": "node scripts/manage-users.js trial",
    "user:disable": "node scripts/manage-users.js disable",
    "user:enable": "node scripts/manage-users.js enable",
    "docs:typecheck-worklist": "node scripts/generate-typecheck-worklist.js",
    "docs:conformance-evidence": "node scripts/conformance-evidence.js",
    "docs:factor-manifest": "node scripts/generate-factor-manifest.js",
    "docs:parta-manifest": "node scripts/generate-parta-manifest.js",
    "docs:parta-sovereign-manifest": "node scripts/generate-parta-sovereign-manifest.js",
    "db:test-up": "node scripts/test-db.js up",
    "db:test-down": "node scripts/test-db.js down",
    "db:test-status": "node scripts/test-db.js status",
    "docs:code-tour": "node scripts/generate-code-tour.js",
    "docs:readme": "node scripts/generate-readme-endpoints.js"
  },
  "keywords": [
    "carbon",
    "fintech",
    "green-finance",
    "pcaf",
    "taxonomy",
    "construction",
    "embodied-carbon",
    "regtech",
    "green-loans",
    "esg"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@netlify/blobs": "^11.0.3",
    "@netlify/functions": "^2.8.2",
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dotenv": "^17.3.1",
    "esbuild": "^0.25.12",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^12.0.0",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "morgan": "^1.10.0",
    "pdfkit": "^0.15.2",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "serverless-http": "^3.2.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@playwright/test": "^1.63.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@types/pdfkit": "^0.17.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.20.0",
    "jest": "^29.7.0",
    "marked": "^9.1.6",
    "supertest": "^7.0.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/dist/"
    ],
    "setupFiles": [
      "./tests/setup.js"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "branches": 25,
        "functions": 55,
        "lines": 55,
        "statements": 55
      },
      "src/domains/gcf/": {
        "branches": 70,
        "functions": 90,
        "lines": 92
      },
      "src/domains/capital/": {
        "branches": 72,
        "functions": 88,
        "lines": 92
      },
      "src/domains/pcaf-part-c/": {
        "branches": 68,
        "functions": 85,
        "lines": 88
      },
      "src/domains/pcaf-part-a/": {
        "branches": 70,
        "functions": 88,
        "lines": 82
      },
      "src/domains/taxonomy/": {
        "branches": 72,
        "functions": 88,
        "lines": 84
      },
      "src/domains/baseline/": {
        "branches": 55,
        "functions": 78,
        "lines": 85
      },
      "src/domains/lending/": {
        "branches": 40,
        "functions": 55,
        "lines": 63
      },
      "src/platform/": {
        "branches": 45,
        "functions": 60,
        "lines": 60
      },
      "src/shared/": {
        "branches": 75,
        "functions": 85,
        "lines": 88
      },
      "netlify/functions/": {
        "branches": 12,
        "functions": 15,
        "lines": 25
      }
    },
    "globalSetup": "./tests/global-setup.js",
    "testTimeout": 30000,
    "setupFilesAfterEnv": [
      "./tests/setup-after-env.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "netlify/functions/**/*.js",
      "!src/**/index.js"
    ]
  }
}
