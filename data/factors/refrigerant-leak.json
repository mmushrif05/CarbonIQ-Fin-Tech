    "Chillers (large HVAC)":              { "value": 0.05, "range": "~2-15%; office ~2%, mid ~5%" },
    "Commercial refrigeration":           { "value": 0.15, "range": "~10-35%; mid ~15%" },
    "Industrial process refrigeration":   { "value": 0.12, "range": "~10-25%; mid ~12%" },
