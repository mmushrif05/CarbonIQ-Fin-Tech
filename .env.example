# ===== CarbonIQ FinTech — Environment Variables =====
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Shared with Core Platform (REQUIRED) ---
# Same values as the main Carbon-Management .env
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_SERVICE_ACCOUNT=base64-encoded-service-account-json
# A real key begins "sk-ant-" and is roughly 100 characters. A placeholder
# left in place is refused explicitly rather than failing as "401 terminated"
# on the first agent call — check with: GET /v1/agent/health
ANTHROPIC_API_KEY=your-anthropic-api-key
DATA_ENCRYPTION_KEY=your-64-char-hex-key

# --- Storage ---
# Where records live. Unset = automatic: PostgreSQL when DATABASE_URL is set,
# else Firebase when configured, else in-process memory (local development
# only). Netlify Blobs is never chosen automatically — the database is
# provisioned apart from the hosting platform — but STORAGE_BACKEND=blobs
# selects it explicitly. Force one with
# STORAGE_BACKEND=postgres|firebase|blobs|memory; a forced store that is
# unreachable refuses writes rather than falling back.
STORAGE_BACKEND=
# PostgreSQL — the one database: registry, capital book, GCF pipeline, audit
# chain, API keys, Part C runs. Provisioned by the operator on any managed
# host; see docs/DATA-LAYER.md "Provisioning the database".
#   postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
# Schema within the database; default public.
DATABASE_SCHEMA=
# true | no-verify | false. Unset: the URL's sslmode decides, and a URL
# without one gets TLS with verification for any host that is not local.
DATABASE_SSL=
# Connections per process; keep small on serverless.
DATABASE_POOL_MAX=3

# --- Observability (see docs/OBSERVABILITY.md) ---
# JSON log lines on stdout; the platform's log drain forwards them.
LOG_LEVEL=info
# Error reporting. Unset = inert; /health reports whether one is set, never
# what it is. Copy the DSN from the Sentry project's client keys.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# --- Jobs (see docs/JOBS.md) ---
# The queue is the jobs table on DATABASE_URL. The API pokes the Netlify
# background worker with this shared token at this site URL; without them
# the ten-minute sweep works the queue instead. JOBS_INLINE=1 runs a job
# inside the request that enqueued it (local development, tests).
JOBS_TOKEN=
JOBS_URL=
JOBS_INLINE=

# --- FinTech API Server ---
FINTECH_API_PORT=3001
FINTECH_API_ENABLED=true
NODE_ENV=development

# --- CORS ---
# Comma-separated allowed origins for bank integrations
ALLOWED_ORIGINS=http://localhost:3000,https://carboniqfintech.netlify.app

# --- CarbonIQ core platform (optional) ---
# Deployment hosting the core engine's parse-boq and carbon-advisor
# functions. Only the two bridge/ai.js calls need it; leave unset and
# those refuse with a 503 naming this variable rather than timing out
# against a host that no longer answers.
CORE_APP_URL=

# --- API Key Management ---
# Salt for hashing API keys (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
API_KEY_SALT=generate-a-64-char-hex-string
API_KEY_DEFAULT_RATE_LIMIT=100

# UI Dashboard key. The deployment hands it to the browser via GET /v1/ui-config.js.
# Format: ck_test_ + exactly 32 alphanumeric characters. Holds the scopes
# read, write, lock and assess — never admin.
UI_API_KEY=ck_test_00000000000000000000000000000000
# Local-development bypass when Firebase is not configured. Boot validation
# refuses a production deployment that has it set.
DEV_API_KEY=

# --- PCAF Configuration ---
PCAF_VERSION=3.0
# Default attribution factor (1.0 = 100% of emissions attributed to the bank)
PCAF_DEFAULT_ATTRIBUTION=1.0

# --- Taxonomy Versions ---
TAXONOMY_ASEAN_VERSION=3
TAXONOMY_EU_VERSION=2024
TAXONOMY_HK_VERSION=2024

# --- Webhook Configuration ---
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_RETRIES=3
# Secret for signing webhook payloads (HMAC-SHA256)
WEBHOOK_SIGNING_SECRET=generate-a-random-secret

# --- Feature Flags ---
# Enable/disable features as they are built
FF_COVENANT_ENGINE=true
FF_PORTFOLIO_AGGREGATION=true
FF_TAXONOMY_CHECKER=true
FF_CERTIFICATE_GENERATION=false
FF_INSURANCE_OUTPUT=false

# --- Logging ---
LOG_LEVEL=info
# Set to 'true' to log full request/response bodies (development only)
LOG_VERBOSE=false
