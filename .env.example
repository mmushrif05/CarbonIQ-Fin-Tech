# ===== CarbonIQ FinTech — Environment Variables =====
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# --- The 4 KB ceiling on a serverless deployment ---
# Netlify Functions are AWS Lambdas, and Lambda refuses to create a function
# whose configured environment exceeds 4,096 bytes in total — every name and
# every value set on the function, the operator's and the ones Netlify sets
# beside them. The deploy fails at function creation, names a size and not a
# variable, and the site keeps serving the last build that worked, so the
# change simply does not appear.
#
# Almost all of a deployment's budget goes on one or two values.
# FIREBASE_SERVICE_ACCOUNT is a base64 service account of roughly 2,400 to
# 3,000 bytes and is read only where Firebase is the store; on a deployment
# holding its records in PostgreSQL it can be scoped to Builds alone or
# removed. DATABASE_URL is about 120 bytes and buys the whole store.
#
# config.validate() estimates the total on a serverless runtime and, once
# three quarters of the budget is spent, names the largest variables under
# /health configured.warnings — names and byte counts only, never a value. It
# is a warning and nothing refuses on it: the figure is an estimate, and the
# one build that refused on it took every route down.

# --- Shared with Core Platform (REQUIRED) ---
# Same values as the main Carbon-Management .env
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
FIREBASE_SERVICE_ACCOUNT=base64-encoded-service-account-json
# A real key begins "sk-ant-" and is roughly 100 characters. A placeholder
# left in place is refused explicitly rather than failing as "401 terminated"
# on the first agent call — check with: GET /v1/agent/health
ANTHROPIC_API_KEY=your-anthropic-api-key
DATA_ENCRYPTION_KEY=your-64-char-hex-key

# --- Preview access (see docs/AUTHENTICATION.md) ---
# The public door onto the sample book: an address is exchanged for a
# read-only session in an organisation whose only records are a sample book,
# and the address is kept in the preview register. On unless set to "off" —
# what the route can do is bounded by construction, so the usual reason to
# default a public door shut does not apply. GET /v1/auth/preview says whether
# it is open, and the sign-in screen offers the panel only where it is.
PREVIEW_ACCESS=

# --- Storage ---
# Where records live. Unset = automatic: PostgreSQL when DATABASE_URL is set,
# else Firebase when configured, else in-process memory (local development
# only). Netlify Blobs is never chosen automatically — the database is
# provisioned apart from the hosting platform — but STORAGE_BACKEND=blobs
# selects it explicitly. Force one with
# STORAGE_BACKEND=postgres|firebase|blobs|memory; a forced store that is
# unreachable refuses writes rather than falling back.
STORAGE_BACKEND=
# PostgreSQL — the one database: registry, capital book, GCF pipeline, audit
# chain, API keys, Part C runs. Provisioned by the operator on any managed
# host; see docs/DATA-LAYER.md "Provisioning the database".
#   postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=
# Schema within the database; default public.
DATABASE_SCHEMA=
# true | no-verify | false. Unset: the URL's sslmode decides, and a URL
# without one gets TLS with verification for any host that is not local.
DATABASE_SSL=
# Connections per process; keep small on serverless.
DATABASE_POOL_MAX=3

# --- Observability (see docs/OBSERVABILITY.md) ---
# JSON log lines on stdout; the platform's log drain forwards them.
LOG_LEVEL=info
# Error reporting. Unset = inert; /health reports whether one is set, never
# what it is. Copy the DSN from the Sentry project's client keys.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# --- Jobs (see docs/JOBS.md) ---
# The queue is the jobs table on DATABASE_URL. The API pokes the Netlify
# background worker with this shared token at this site URL; without them
# the ten-minute sweep works the queue instead. JOBS_INLINE=1 runs a job
# inside the request that enqueued it (local development, tests).
JOBS_TOKEN=
JOBS_URL=
JOBS_INLINE=

# --- FinTech API Server ---
FINTECH_API_PORT=3001
FINTECH_API_ENABLED=true
NODE_ENV=development

# --- CORS ---
# Comma-separated allowed origins for bank integrations
ALLOWED_ORIGINS=http://localhost:3000,https://carboniqfintech.netlify.app

# --- CarbonIQ core platform (optional) ---
# Deployment hosting the core engine's parse-boq and carbon-advisor
# functions. Only the two bridge/ai.js calls need it; leave unset and
# those refuse with a 503 naming this variable rather than timing out
# against a host that no longer answers.
CORE_APP_URL=

# --- API Key Management ---
# Salt for hashing API keys (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
API_KEY_SALT=generate-a-64-char-hex-string
API_KEY_DEFAULT_RATE_LIMIT=100

# UI Dashboard key. The deployment hands it to the browser via GET /v1/ui-config.js.
# Format: ck_test_ + exactly 32 alphanumeric characters. Holds the scopes
# read, write, lock and assess — never admin.
UI_API_KEY=ck_test_00000000000000000000000000000000
# Local-development bypass when Firebase is not configured. Boot validation
# refuses a production deployment that has it set.
DEV_API_KEY=

# --- PCAF Configuration ---
PCAF_VERSION=3.0
# Default attribution factor (1.0 = 100% of emissions attributed to the bank)
PCAF_DEFAULT_ATTRIBUTION=1.0

# --- Taxonomy Versions ---
TAXONOMY_ASEAN_VERSION=3
TAXONOMY_EU_VERSION=2024
TAXONOMY_HK_VERSION=2024

# --- Webhook Configuration ---
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_RETRIES=3
# Secret for signing webhook payloads (HMAC-SHA256)
WEBHOOK_SIGNING_SECRET=generate-a-random-secret

# --- Feature Flags ---
# Enable/disable features as they are built
FF_COVENANT_ENGINE=true
FF_PORTFOLIO_AGGREGATION=true
FF_TAXONOMY_CHECKER=true
FF_CERTIFICATE_GENERATION=false
FF_INSURANCE_OUTPUT=false

# --- Logging ---
LOG_LEVEL=info
# Set to 'true' to log full request/response bodies (development only)
LOG_VERBOSE=false

# ---------------------------------------------------------------------------
# Authentication (docs/AUTHENTICATION.md)
# ---------------------------------------------------------------------------
# A deployment starts with no accounts. Create the first administrator with:
#   npm run user:create -- --email you@bank.lk --org <org-id> --role admin
# GET /health reports configured.accounts so an empty deployment says so.

# Lets the first administrator be created over HTTP, at POST /v1/auth/bootstrap,
# on a deployment with no shell beside its database. Set it to a long random
# value before the first deploy. The route answers only while the deployment
# holds no accounts at all, so the window closes with the account it creates
# and cannot be reopened; unset, the route refuses rather than waving anyone
# through. Remove it once the first administrator exists.
ADMIN_BOOTSTRAP_TOKEN=

# The first administrator from the build, for a deployment with no shell whose
# first-run window has closed (scripts/first-admin.js). Set in the deployment
# environment, never here: with an address and a password the build creates
# that account as an administrator in FIRST_ADMIN_ORG, or — only with
# FIRST_ADMIN_RESET=true — replaces the password of the account that already
# holds the address. Mark the password secret and delete both once signed in:
# while RESET stands, every build sets it back.
FIRST_ADMIN_EMAIL=
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_ORG=
FIRST_ADMIN_RESET=

# What every document may be taken for: self_declared (the default) or
# verified. The tool provider's choice, never the reporting entity's, and a
# value recorded per organisation overrides this one. `verified` is a request:
# it resolves back to self_declared, with the reason printed on the document,
# until every governed value is released and the entity has recorded who
# assured the figures. See docs/ASSURANCE-MODE.md.
ASSURANCE_MODE=

# A migration window for API keys issued before scopes existed. Unset, such a
# key is held to `read`. config.validate() refuses this in production.
ALLOW_UNSCOPED_KEYS=

# A deploy preview refuses to run migrations, because it may share whatever
# DATABASE_URL is set at site scope. Set this only where the preview has its
# own database.
ALLOW_PREVIEW_MIGRATIONS=
